{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arv:schema:checkpoint-witness-bundle:v1",
  "title": "ARV Checkpoint Witness Bundle V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "bundle_id", "witness_policy_id", "witness_policy_version",
    "checkpoint_id", "checkpoint_hash", "sequence", "observations"
  ],
  "properties": {
    "schema": { "const": "arv.checkpoint-witness-bundle" },
    "schema_version": { "const": 1 },
    "bundle_id": { "type": "string", "pattern": "^ARV-WITNESS-BUNDLE-[A-Z0-9-]+$" },
    "witness_policy_id": { "type": "string", "pattern": "^ARV-WITNESS-POLICY-[A-Z0-9-]+$" },
    "witness_policy_version": { "type": "integer", "minimum": 1 },
    "checkpoint_id": { "type": "string", "pattern": "^ARV-TRUST-CHECKPOINT-[A-Z0-9-]+$" },
    "checkpoint_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:arv:schema:checkpoint-witness-observation:v1" }
    }
  }
}
