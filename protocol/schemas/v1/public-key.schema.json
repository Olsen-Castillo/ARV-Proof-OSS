{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Olsen-Castillo/ARV-Proof-OSS/main/protocol/schemas/v1/public-key.schema.json",
  "title": "ARV Public Key Descriptor V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "algorithm",
    "fingerprint",
    "public_key_base64",
    "status"
  ],
  "properties": {
    "schema": { "const": "arv.public-key" },
    "schema_version": { "const": 1 },
    "algorithm": { "const": "Ed25519" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
    "public_key_base64": { "type": "string", "minLength": 1 },
    "status": { "enum": ["ACTIVE", "REVOKED", "RETIRED"] }
  }
}
