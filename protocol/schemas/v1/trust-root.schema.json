{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arv:schema:trust-root:v1",
  "title": "ARV Official Trust Root V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "root_id",
    "root_version",
    "epoch",
    "issued_at",
    "valid_from",
    "expires_at",
    "threshold",
    "recovery_threshold",
    "previous_root_hash",
    "policy_digest",
    "keys"
  ],
  "properties": {
    "schema": { "const": "arv.trust-root" },
    "schema_version": { "const": 1 },
    "root_id": { "type": "string", "pattern": "^ARV-ROOT-[A-Z0-9-]+$" },
    "root_version": { "type": "integer", "minimum": 1 },
    "epoch": { "type": "integer", "minimum": 1 },
    "issued_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "valid_from": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "expires_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "threshold": { "type": "integer", "minimum": 1 },
    "recovery_threshold": { "type": "integer", "minimum": 1 },
    "previous_root_hash": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      ]
    },
    "policy_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "keys": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/key" }
    }
  },
  "$defs": {
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "algorithm",
        "public_key_base64",
        "roles",
        "status",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "key_id": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
        "algorithm": { "const": "Ed25519" },
        "public_key_base64": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["ROOT", "RECOVERY"] }
        },
        "status": { "enum": ["ACTIVE", "REVOKED", "RETIRED"] },
        "valid_from": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "valid_until": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time", "pattern": "Z$" }
          ]
        }
      }
    }
  }
}
