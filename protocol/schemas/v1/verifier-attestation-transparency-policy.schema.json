{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arv.example/schemas/arv-v1/verifier-attestation-transparency-policy.schema.json",
  "title": "ARV Verifier Attestation Transparency Policy V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "policy_id", "log_id", "policy_version", "root_id", "root_version", "root_epoch", "root_hash", "operator_threshold", "monitor_threshold", "max_checkpoint_age_seconds", "max_clock_skew_seconds", "operators", "monitors", "issued_at"],
  "properties": {
    "schema": {"const": "arv.verifier-attestation-transparency-policy"},
    "schema_version": {"const": 1},
    "policy_id": {"type": "string", "pattern": "^ARV-ATTESTATION-TRANSPARENCY-POLICY-[A-Z0-9-]+$"},
    "log_id": {"type": "string", "pattern": "^ARV-ATTESTATION-TRANSPARENCY-LOG-[A-Z0-9-]+$"},
    "policy_version": {"type": "integer", "minimum": 1},
    "root_id": {"type": "string", "pattern": "^ARV-ROOT-[A-Z0-9-]+$"},
    "root_version": {"type": "integer", "minimum": 1},
    "root_epoch": {"type": "integer", "minimum": 1},
    "root_hash": {"$ref": "#/$defs/digest"},
    "operator_threshold": {"type": "integer", "minimum": 1},
    "monitor_threshold": {"type": "integer", "minimum": 1},
    "max_checkpoint_age_seconds": {"type": "integer", "minimum": 1},
    "max_clock_skew_seconds": {"type": "integer", "minimum": 1},
    "operators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/signer"}},
    "monitors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/signer"}},
    "issued_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "signer": {"type": "object", "additionalProperties": false, "required": ["signer_id", "key_id", "algorithm", "public_key_spki_base64", "status", "valid_from", "expires_at"], "properties": {
      "signer_id": {"type": "string", "pattern": "^ARV-(TRANSPARENCY-LOG-OPERATOR|TRANSPARENCY-MONITOR)-[A-Z0-9-]+$"},
      "key_id": {"type": "string", "pattern": "^[a-f0-9]{24,128}$"},
      "algorithm": {"const": "Ed25519"},
      "public_key_spki_base64": {"type": "string", "contentEncoding": "base64"},
      "status": {"enum": ["ACTIVE", "REVOKED"]},
      "valid_from": {"$ref": "#/$defs/timestamp"},
      "expires_at": {"$ref": "#/$defs/timestamp"}
    }}
  }
}
