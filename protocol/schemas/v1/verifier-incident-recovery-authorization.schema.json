{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arv.example/schemas/arv-v1/verifier-incident-recovery-authorization.schema.json",
  "title": "ARV Verifier Incident Recovery Authorization V1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "authorization_id", "incident_id", "incident_hash", "quarantine_state_hash", "policy_hash", "root_id", "root_version", "root_epoch", "root_hash", "issued_at", "expires_at", "reason_digest", "root_authorizations", "adjudicator_authorizations"],
  "properties": {
    "schema": {"const": "arv.verifier-incident-recovery-authorization"}, "schema_version": {"const": 1},
    "authorization_id": {"type": "string", "pattern": "^ARV-INCIDENT-RECOVERY-[A-Z0-9-]+$"},
    "incident_id": {"type": "string", "pattern": "^ARV-INCIDENT-[A-Z0-9-]+$"},
    "incident_hash": {"$ref": "#/$defs/digest"}, "quarantine_state_hash": {"$ref": "#/$defs/digest"}, "policy_hash": {"$ref": "#/$defs/digest"},
    "root_id": {"type": "string", "pattern": "^ARV-ROOT-[A-Z0-9-]+$"}, "root_version": {"type": "integer", "minimum": 1}, "root_epoch": {"type": "integer", "minimum": 1}, "root_hash": {"$ref": "#/$defs/digest"},
    "issued_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}, "reason_digest": {"$ref": "#/$defs/digest"},
    "root_authorizations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/signature"}},
    "adjudicator_authorizations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/signature"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signature": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "signature_base64"], "properties": {"algorithm": {"const": "Ed25519"}, "key_id": {"type": "string", "pattern": "^[a-f0-9]{24,128}$"}, "signature_base64": {"type": "string", "contentEncoding": "base64"}}}
  }
}
