{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.arv.example/arv-v1/verifier-installation-evidence.schema.json",
  "title": "ARV Verifier Installation Evidence V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "installation_id", "verifier_id", "instance_id", "activation_sequence", "release_sequence", "release_version", "release_manifest_hash", "release_pin_hash", "runtime_profile_path", "runtime_profile_hash", "observed_artifact_set_digest", "observed_artifacts", "installed_at"],
  "properties": {
    "schema": { "const": "arv.verifier-installation-evidence" },
    "schema_version": { "const": 1 },
    "installation_id": { "type": "string", "pattern": "^ARV-VERIFIER-INSTALLATION-[A-Z0-9-]+$" },
    "verifier_id": { "type": "string", "pattern": "^ARV-VERIFIER-[A-Z0-9-]+$" },
    "instance_id": { "type": "string", "pattern": "^ARV-VERIFIER-INSTANCE-[A-Z0-9-]+$" },
    "activation_sequence": { "type": "integer", "minimum": 1 },
    "release_sequence": { "type": "integer", "minimum": 1 },
    "release_version": { "type": "string" },
    "release_manifest_hash": { "$ref": "#/$defs/digest" },
    "release_pin_hash": { "$ref": "#/$defs/digest" },
    "runtime_profile_path": { "$ref": "#/$defs/path" },
    "runtime_profile_hash": { "$ref": "#/$defs/digest" },
    "observed_artifact_set_digest": { "$ref": "#/$defs/digest" },
    "observed_artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "installed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "media_type": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
