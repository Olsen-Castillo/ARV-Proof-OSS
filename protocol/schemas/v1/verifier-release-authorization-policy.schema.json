{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arv:schema:verifier-release-authorization-policy:v1",
  "title": "ARV Verifier Release Authorization Policy V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "policy_id", "policy_version", "root_id", "root_version",
    "root_epoch", "root_hash", "issued_at", "valid_from", "expires_at", "release_threshold",
    "builder_threshold", "release_keys", "builder_keys", "root_authorizations"
  ],
  "properties": {
    "schema": { "const": "arv.verifier-release-authorization-policy" },
    "schema_version": { "const": 1 },
    "policy_id": { "type": "string", "pattern": "^ARV-VERIFIER-RELEASE-POLICY-[A-Z0-9-]+$" },
    "policy_version": { "type": "integer", "minimum": 1 },
    "root_id": { "type": "string", "pattern": "^ARV-ROOT-[A-Z0-9-]+$" },
    "root_version": { "type": "integer", "minimum": 1 },
    "root_epoch": { "type": "integer", "minimum": 1 },
    "root_hash": { "$ref": "#/$defs/sha256" },
    "issued_at": { "$ref": "#/$defs/timestamp" },
    "valid_from": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "release_threshold": { "type": "integer", "minimum": 1 },
    "builder_threshold": { "type": "integer", "minimum": 1 },
    "release_keys": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/key" } },
    "builder_keys": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/key" } },
    "root_authorizations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/signature" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "nullableTimestamp": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "public_key_base64", "status", "valid_from", "valid_until"],
      "properties": {
        "key_id": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
        "algorithm": { "const": "Ed25519" },
        "public_key_base64": { "type": "string", "minLength": 43 },
        "status": { "enum": ["ACTIVE", "REVOKED", "RETIRED"] },
        "valid_from": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/nullableTimestamp" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signature_base64"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
        "signature_base64": { "type": "string", "minLength": 86 }
      }
    }
  }
}
