{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arv:schema:verifier-release-manifest:v1",
  "title": "ARV Verifier Release Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "manifest_id", "verifier_id", "release_sequence", "release_version",
    "channel", "platform", "source_commit", "source_tree_digest", "build_recipe_digest",
    "toolchain_digest", "sbom_digest", "artifact_set_digest", "artifacts", "policy_id",
    "policy_version", "policy_hash", "root_id", "root_version", "root_epoch", "root_hash",
    "previous_release_hash", "issued_at", "valid_from", "expires_at", "signatures"
  ],
  "properties": {
    "schema": { "const": "arv.verifier-release-manifest" },
    "schema_version": { "const": 1 },
    "manifest_id": { "type": "string", "pattern": "^ARV-VERIFIER-RELEASE-MANIFEST-[A-Z0-9-]+$" },
    "verifier_id": { "type": "string", "pattern": "^ARV-VERIFIER-[A-Z0-9-]+$" },
    "release_sequence": { "type": "integer", "minimum": 1 },
    "release_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "channel": { "enum": ["STABLE", "SECURITY"] },
    "platform": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
    "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "source_tree_digest": { "$ref": "#/$defs/sha256" },
    "build_recipe_digest": { "$ref": "#/$defs/sha256" },
    "toolchain_digest": { "$ref": "#/$defs/sha256" },
    "sbom_digest": { "$ref": "#/$defs/sha256" },
    "artifact_set_digest": { "$ref": "#/$defs/sha256" },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "policy_id": { "type": "string", "pattern": "^ARV-VERIFIER-RELEASE-POLICY-[A-Z0-9-]+$" },
    "policy_version": { "type": "integer", "minimum": 1 },
    "policy_hash": { "$ref": "#/$defs/sha256" },
    "root_id": { "type": "string", "pattern": "^ARV-ROOT-[A-Z0-9-]+$" },
    "root_version": { "type": "integer", "minimum": 1 },
    "root_epoch": { "type": "integer", "minimum": 1 },
    "root_hash": { "$ref": "#/$defs/sha256" },
    "previous_release_hash": { "$ref": "#/$defs/nullableSha256" },
    "issued_at": { "$ref": "#/$defs/timestamp" },
    "valid_from": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "signatures": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/signature" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$" },
        "media_type": { "type": "string", "minLength": 3 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signature_base64"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
        "signature_base64": { "type": "string", "minLength": 86 }
      }
    }
  }
}
