{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arv:schema:verifier-release-pin:v1",
  "title": "ARV Verifier Release Pin V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "pin_id", "verifier_id", "generation", "release_sequence",
    "release_version", "manifest_id", "manifest_hash", "policy_id", "policy_version", "policy_hash",
    "trusted_state_hash", "installed_at", "previous_pin_hash"
  ],
  "properties": {
    "schema": { "const": "arv.verifier-release-pin" },
    "schema_version": { "const": 1 },
    "pin_id": { "type": "string", "pattern": "^ARV-VERIFIER-RELEASE-PIN-[A-Z0-9-]+$" },
    "verifier_id": { "type": "string", "pattern": "^ARV-VERIFIER-[A-Z0-9-]+$" },
    "generation": { "type": "integer", "minimum": 1 },
    "release_sequence": { "type": "integer", "minimum": 1 },
    "release_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "manifest_id": { "type": "string", "pattern": "^ARV-VERIFIER-RELEASE-MANIFEST-[A-Z0-9-]+$" },
    "manifest_hash": { "$ref": "#/$defs/sha256" },
    "policy_id": { "type": "string", "pattern": "^ARV-VERIFIER-RELEASE-POLICY-[A-Z0-9-]+$" },
    "policy_version": { "type": "integer", "minimum": 1 },
    "policy_hash": { "$ref": "#/$defs/sha256" },
    "trusted_state_hash": { "$ref": "#/$defs/sha256" },
    "installed_at": { "$ref": "#/$defs/timestamp" },
    "previous_pin_hash": { "$ref": "#/$defs/nullableSha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" }
  }
}
