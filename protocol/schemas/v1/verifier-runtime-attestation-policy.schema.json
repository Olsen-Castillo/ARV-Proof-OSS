{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arv.example/schemas/arv-v1/verifier-runtime-attestation-policy.schema.json",
  "title": "ARV Verifier Runtime Attestation Policy V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "policy_id", "verifier_id", "policy_version", "root_id", "root_version", "root_epoch", "root_hash", "attestation_threshold", "max_attestation_age_seconds", "max_clock_skew_seconds", "allowed_event_types", "attestors", "issued_at"],
  "properties": {
    "schema": {"const": "arv.verifier-runtime-attestation-policy"},
    "schema_version": {"const": 1},
    "policy_id": {"type": "string", "pattern": "^ARV-VERIFIER-RUNTIME-ATTESTATION-POLICY-[A-Z0-9-]+$"},
    "verifier_id": {"type": "string", "pattern": "^ARV-VERIFIER-[A-Z0-9-]+$"},
    "policy_version": {"type": "integer", "minimum": 1},
    "root_id": {"type": "string", "pattern": "^ARV-ROOT-[A-Z0-9-]+$"},
    "root_version": {"type": "integer", "minimum": 1},
    "root_epoch": {"type": "integer", "minimum": 1},
    "root_hash": {"$ref": "#/$defs/digest"},
    "attestation_threshold": {"type": "integer", "minimum": 1},
    "max_attestation_age_seconds": {"type": "integer", "minimum": 1},
    "max_clock_skew_seconds": {"type": "integer", "minimum": 1},
    "allowed_event_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["BOOT", "DRIFT_DETECTED", "INCIDENT_REPORTED", "QUARANTINE_ENTERED", "QUARANTINE_RELEASED", "RUNTIME_CHECK", "SHUTDOWN", "UPDATE_ACTIVATED"]}},
    "attestors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/attestor"}},
    "issued_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "attestor": {"type": "object", "additionalProperties": false, "required": ["attestor_id", "key_id", "algorithm", "public_key_spki_base64", "status", "valid_from", "expires_at"], "properties": {
      "attestor_id": {"type": "string", "pattern": "^ARV-RUNTIME-ATTESTOR-[A-Z0-9-]+$"},
      "key_id": {"type": "string", "pattern": "^[a-f0-9]{24,128}$"},
      "algorithm": {"const": "Ed25519"},
      "public_key_spki_base64": {"type": "string", "contentEncoding": "base64"},
      "status": {"enum": ["ACTIVE", "REVOKED"]},
      "valid_from": {"$ref": "#/$defs/timestamp"},
      "expires_at": {"$ref": "#/$defs/timestamp"}
    }}
  }
}
