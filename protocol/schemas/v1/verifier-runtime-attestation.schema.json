{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arv.example/schemas/arv-v1/verifier-runtime-attestation.schema.json",
  "title": "ARV Verifier Runtime Attestation V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "attestation_id", "verifier_id", "instance_id", "attestation_sequence", "activation_sequence", "release_manifest_hash", "activation_pin_hash", "runtime_measurement_hash", "security_event_chain_hash", "challenge_nonce", "policy_id", "policy_version", "policy_hash", "root_id", "root_version", "root_epoch", "root_hash", "issued_at", "expires_at", "previous_attestation_hash", "signatures"],
  "properties": {
    "schema": {"const": "arv.verifier-runtime-attestation"}, "schema_version": {"const": 1},
    "attestation_id": {"type": "string", "pattern": "^ARV-VERIFIER-RUNTIME-ATTESTATION-[A-Z0-9-]+$"},
    "verifier_id": {"$ref": "#/$defs/verifier"}, "instance_id": {"$ref": "#/$defs/instance"},
    "attestation_sequence": {"type": "integer", "minimum": 1}, "activation_sequence": {"type": "integer", "minimum": 1},
    "release_manifest_hash": {"$ref": "#/$defs/digest"}, "activation_pin_hash": {"$ref": "#/$defs/digest"},
    "runtime_measurement_hash": {"$ref": "#/$defs/digest"}, "security_event_chain_hash": {"$ref": "#/$defs/digest"},
    "challenge_nonce": {"type": "string", "pattern": "^[a-f0-9]{32,128}$"},
    "policy_id": {"type": "string", "pattern": "^ARV-VERIFIER-RUNTIME-ATTESTATION-POLICY-[A-Z0-9-]+$"}, "policy_version": {"type": "integer", "minimum": 1}, "policy_hash": {"$ref": "#/$defs/digest"},
    "root_id": {"type": "string", "pattern": "^ARV-ROOT-[A-Z0-9-]+$"}, "root_version": {"type": "integer", "minimum": 1}, "root_epoch": {"type": "integer", "minimum": 1}, "root_hash": {"$ref": "#/$defs/digest"},
    "issued_at": {"$ref": "#/$defs/timestamp"}, "expires_at": {"$ref": "#/$defs/timestamp"},
    "previous_attestation_hash": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "signatures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/signature"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "timestamp": {"type": "string", "format": "date-time"},
    "verifier": {"type": "string", "pattern": "^ARV-VERIFIER-[A-Z0-9-]+$"}, "instance": {"type": "string", "pattern": "^ARV-VERIFIER-INSTANCE-[A-Z0-9-]+$"},
    "signature": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "signature_base64"], "properties": {"algorithm": {"const": "Ed25519"}, "key_id": {"type": "string", "pattern": "^[a-f0-9]{24,128}$"}, "signature_base64": {"type": "string", "contentEncoding": "base64"}}}
  }
}
