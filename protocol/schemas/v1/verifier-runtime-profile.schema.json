{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.arv.example/arv-v1/verifier-runtime-profile.schema.json",
  "title": "ARV Verifier Runtime Profile V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "profile_id", "verifier_id", "release_sequence", "platform", "executable_path", "required_artifact_paths", "executable_digest", "configuration_digest", "policy_bundle_digest", "schema_bundle_digest", "dependency_set_digest", "allowed_module_set_digest", "environment_constraints_digest"],
  "properties": {
    "schema": { "const": "arv.verifier-runtime-profile" },
    "schema_version": { "const": 1 },
    "profile_id": { "type": "string", "pattern": "^ARV-VERIFIER-RUNTIME-PROFILE-[A-Z0-9-]+$" },
    "verifier_id": { "type": "string", "pattern": "^ARV-VERIFIER-[A-Z0-9-]+$" },
    "release_sequence": { "type": "integer", "minimum": 1 },
    "platform": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
    "executable_path": { "$ref": "#/$defs/path" },
    "required_artifact_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "executable_digest": { "$ref": "#/$defs/digest" },
    "configuration_digest": { "$ref": "#/$defs/digest" },
    "policy_bundle_digest": { "$ref": "#/$defs/digest" },
    "schema_bundle_digest": { "$ref": "#/$defs/digest" },
    "dependency_set_digest": { "$ref": "#/$defs/digest" },
    "allowed_module_set_digest": { "$ref": "#/$defs/digest" },
    "environment_constraints_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$" }
  }
}
