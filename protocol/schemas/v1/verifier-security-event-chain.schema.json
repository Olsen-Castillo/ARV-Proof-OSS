{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arv.example/schemas/arv-v1/verifier-security-event-chain.schema.json",
  "title": "ARV Verifier Security Event Chain V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "chain_id", "verifier_id", "instance_id", "first_event_sequence", "last_event_sequence", "previous_chain_hash", "events", "closed_at"],
  "properties": {
    "schema": {"const": "arv.verifier-security-event-chain"}, "schema_version": {"const": 1},
    "chain_id": {"type": "string", "pattern": "^ARV-VERIFIER-SECURITY-EVENT-CHAIN-[A-Z0-9-]+$"},
    "verifier_id": {"type": "string", "pattern": "^ARV-VERIFIER-[A-Z0-9-]+$"}, "instance_id": {"type": "string", "pattern": "^ARV-VERIFIER-INSTANCE-[A-Z0-9-]+$"},
    "first_event_sequence": {"type": "integer", "minimum": 1}, "last_event_sequence": {"type": "integer", "minimum": 1},
    "previous_chain_hash": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "verifier-security-event.schema.json"}},
    "closed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
